{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "handoff",
  "description": "Versioned custom SI contract; not an IBM native schema. Static schema checks do not replace containment, hash, arithmetic, runtime or authorization validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stage_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "persona": {
      "enum": [
        "si-orchestrator",
        "si-architect",
        "si-pm",
        "si-commercial",
        "si-collator",
        "si-developer",
        "si-senior-reviewer",
        "si-qa",
        "si-tech-lead"
      ]
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "kit_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "unresolved_decisions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bob_task_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "actual_bobcoins": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "gate_decision": {
      "enum": [
        "passed",
        "blocked",
        "failed",
        "stopped"
      ]
    },
    "native_error": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "stage_id",
    "persona",
    "source_revision",
    "kit_version",
    "scope",
    "inputs",
    "outputs",
    "findings",
    "unresolved_decisions",
    "bob_task_id",
    "actual_bobcoins",
    "gate_decision",
    "native_error"
  ],
  "additionalProperties": false
}
