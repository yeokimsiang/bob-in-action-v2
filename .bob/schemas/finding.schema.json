{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "finding",
  "description": "Versioned custom SI contract; not an IBM native schema. Static schema checks do not replace containment, hash, arithmetic, runtime or authorization validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "informational"
      ]
    },
    "evidence_status": {
      "enum": [
        "observed",
        "inferred",
        "assumed",
        "unknown"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "locator",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "open",
        "accepted",
        "rejected",
        "resolved",
        "TBD"
      ]
    }
  },
  "required": [
    "schema_version",
    "finding_id",
    "run_id",
    "source_revision",
    "title",
    "severity",
    "evidence_status",
    "evidence",
    "impact",
    "recommendation",
    "status"
  ],
  "additionalProperties": false
}
